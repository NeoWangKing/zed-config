// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "git": {
    "disable_git": false
  },
  "agent": {
    "terminal_init_command": "dsh",
    "single_file_review": false,
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "collaboration_panel": {
    "default_width": 320.0
  },
  "git_panel": {
    "show_count_badge": false,
    "entry_primary_click_action": "project_diff",
    "diff_stats": true,
    "folder_icons": false,
    "file_icons": false,
    "tree_view": false,
    "collapse_untracked_diff": false,
    "group_by": "status",
    "sort_by": "path",
    "status_style": "icon",
    "dock": "left"
  },
  "outline_panel": {
    "folder_icons": false,
    "file_icons": false
  },
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 0.5
  },
  "window_decorations": "client",
  "bottom_dock_layout": "contained",
  "tabs": {
    "show_diagnostics": "errors",
    "file_icons": false,
    "git_status": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_user_picture": false,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_worktree_name": true,
    "show_branch_name": true,
    "show_branch_status_icon": false
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false
    },
    "bell": "system",
    "alternate_scroll": "on",
    "font_weight": 400.0,
    "button": true
  },
  "project_panel": {
    "sort_mode": "directories_first",
    "hide_root": false,
    "scrollbar": {
      "horizontal_scroll": true
    },
    "sticky_scroll": true,
    "git_status_indicator": false,
    "diagnostic_badges": true,
    "show_diagnostics": "errors",
    "auto_fold_dirs": true,
    "bold_folder_labels": true,
    "starts_open": false,
    "auto_reveal_entries": true,
    "git_status": true,
    "indent_size": 20.0,
    "folder_icons": false,
    "file_icons": false,
    "entry_spacing": "comfortable",
    "dock": "left",
    "button": true
  },
  "debugger": {
    "button": true
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true,
    "line_endings_button": false
  },
  "search": {
    "button": true,
    "regex": true,
    "include_ignored": true
  },
  "use_smartcase_search": true,
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": false
    }
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "active_line_width": 2,
    "line_width": 1,
    "enabled": true
  },
  "allow_rewrap": "in_comments",
  "show_wrap_guides": true,
  "soft_wrap": "editor_width",
  "tab_size": 4,
  "vim": {
    "cursor_shape": {
      "insert": "bar"
    },
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true
  },
  "toolbar": {
    "code_actions": true,
    "selections_menu": true,
    "quick_actions": true,
    "breadcrumbs": true
  },
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "cursors": true
  },
  "relative_line_numbers": "enabled",
  "auto_signature_help": false,
  "sticky_scroll": {
    "enabled": false
  },
  "autoscroll_on_clicks": true,
  "mouse_wheel_zoom": true,
  "scroll_sensitivity": 1.0,
  "vertical_scroll_margin": 5.0,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "which_key": {
    "enabled": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "current_line_highlight": "all",
  "unnecessary_code_fade": 0.4,
  "cursor_shape": "bar",
  "cursor_blink": false,
  "markdown_preview_code_font_family": "JetBrainsMono Nerd Font",
  "markdown_preview_font_family": ".SystemUIFont",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_weight": 500.0,
  "ui_font_weight": 500.0,
  "icon_theme": {
    "mode": "system",
    "light": "VSCode Icons for Zed (Light Angular)",
    "dark": "VSCode Icons for Zed (Dark Angular)"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "ui_font_size": 17.0,
  "buffer_font_size": 17.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Gruber Darker",
  },
}
